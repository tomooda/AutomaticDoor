module Motor
exports all
definitions
types
    Command = <open> | <close> | <halt>;
    Position = real
        inv p == CLOSED_POSITION <= p and p <= OPEN_POSITION;
values
    SPEED : real = 0.2;
    OPEN_POSITION : real = 1.0;
    CLOSED_POSITION : real = 0.0;
state Motor of
    command : Command
    position : Position
init s == s = mk_Motor(<halt>, 1.0)
end
operations
    open : () ==> ()
    open() == command := <open>;
    close : () ==> ()
    close() == command := <close>;
    halt : () ==> ()
    halt() == command := <halt>;
    pure getPosition : () ==> Position
    getPosition() == return position;
    setPosition : Position ==> ()
    setPosition(p) == position := p;
    pure isOpening : () ==> bool
    isOpening() == return command = <open>;
    pure isClosing : () ==> bool
    isClosing() == return command = <close>;
    pure isHalted : () ==> bool
    isHalted() == return command = <halt>;
    pure isOpen : () ==> bool
    isOpen() == return position = OPEN_POSITION;
    pure isClosed : () ==> bool
    isClosed() == return position = CLOSED_POSITION;
    tick : () ==> ()
    tick() ==
        (cases command:
            <open> ->
                (position := min(position + SPEED, OPEN_POSITION);
                if position = OPEN_POSITION then halt()),
            <close> ->
                (position := max(position - SPEED, CLOSED_POSITION);
                if position = CLOSED_POSITION then halt()),
            others -> skip
            end)
    post 
        (command~ = <open> => position >= position~)
        and ((command~ = <close> => position <= position~)
            and (command~ = <halt> => position = position~));
functions
    min : real * real -> real
    min(x, y) == if x <= y then x else y;
    max : real * real -> real
    max(x, y) == if x >= y then x else y;
end Motor